#!/bin/bash

#BSUB -J h100_qwen_1b_distance[1-3]%1
#BSUB -o logs/qwen_1b_h100_%I_%J.log
#BSUB -e logs/qwen_1b_h100_%I_%J.log
#BSUB -gpu "num=1:gmodel=NVIDIAH100PCIe"
#BSUB -n 1
#BSUB -R "span[ptile=1]"
#BSUB -R "rusage[mem=64GB]"
#BSUB -q h100
#BSUB -W 12:00

# =============================================================================
# ENVIRONMENT SETUP
# =============================================================================

# Create required directories
mkdir -p logs
mkdir -p distance_results

# Set environment variables for stability
export CUDA_VISIBLE_DEVICES=0
export NCCL_DEBUG=WARN
export PYTHONFAULTHANDLER=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True,max_split_size_mb:256
export CUDA_LAUNCH_BLOCKING=1

# Distributed training setup
export MASTER_ADDR=localhost
export MASTER_PORT=$(shuf -i 29000-29999 -n 1)

echo "Using system-wide PyTorch installation"
python -c "import torch; print(f'PyTorch {torch.__version__}, CUDA available: {torch.cuda.is_available()}')"

# Check GPU memory
nvidia-smi

# =============================================================================
# DISTANCE CONFIGURATION MAPPING
# =============================================================================

case $LSB_JOBINDEX in
    1)
        DISTANCE="baseline"
        ;;
    2)
        DISTANCE="euclidean"
        ;;
    3)
        DISTANCE="minkowski_l2"
        ;;
    *)
        echo "Invalid job index: $LSB_JOBINDEX (must be 1-3)"
        exit 1
        ;;
esac

# =============================================================================
# EXPERIMENT CONFIGURATION
# =============================================================================

WANDB_PROJECT="h100_qwen_1b runs"
STEPS=10000
BATCH_SIZE=2
GRAD_ACCUM=32

# =============================================================================
# DATASET SELECTION
# Set DATASET to either "OpenWebText" or "MiniPile".
# Before using MiniPile for the first time, run:
#   python data/MiniPile/prepare.py
# =============================================================================
DATASET="OpenWebText"

WANDB_RUN_NAME="qwen_1b_${DISTANCE}_${DATASET}_array_${LSB_JOBINDEX}"

echo "Using Qwen-1.5B parameters:"
echo "   - Dataset: $DATASET"
echo "   - Batch Size: $BATCH_SIZE"
echo "   - Gradient Accumulation: $GRAD_ACCUM"
echo "   - Effective Batch Size: $((BATCH_SIZE * GRAD_ACCUM))"
echo "   - Training Steps: $STEPS"

# =============================================================================
# JOB INFORMATION
# =============================================================================

echo "=========== JOB START INFO ==========="
echo "Job Array Index: $LSB_JOBINDEX"
echo "Job ID: $LSB_JOBID"
echo "Model Type: qwen_1b"
echo "Distance Type: $DISTANCE"
echo "Dataset: $DATASET"
echo "WandB Project: $WANDB_PROJECT"
echo "WandB Run Name: $WANDB_RUN_NAME"
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Working Directory: $(pwd)"
echo "MASTER_ADDR: $MASTER_ADDR"
echo "MASTER_PORT: $MASTER_PORT"
echo "Steps: $STEPS"
echo "Batch Size: $BATCH_SIZE"
echo "Gradient Accumulation: $GRAD_ACCUM"
echo "======================================"

# Check if training script exists
if [[ ! -f "train_adam_distances_loss_gpt_bert_qwen.py" ]]; then
    echo "ERROR: train_adam_distances_loss_gpt_bert_qwen.py not found in $(pwd)"
    echo "Directory contents:"
    ls -la
    exit 1
fi

# Check if config exists
if [[ ! -f "config/config.py" ]]; then
    echo "ERROR: config/config.py not found"
    exit 1
fi

# Check that the selected dataset has been prepared
if [[ ! -f "data/${DATASET}/train.bin" ]]; then
    echo "ERROR: data/${DATASET}/train.bin not found."
    if [[ "$DATASET" == "MiniPile" ]]; then
        echo "Run  python data/MiniPile/prepare.py  first to download and tokenize the dataset."
    fi
    exit 1
fi

# Validate the config file before running
echo "Validating configuration..."
python -c "
import sys
sys.path.append('.')
try:
    exec(open('config/config.py').read())
    print('Config validation passed')
except Exception as e:
    print(f'Config validation failed: {e}')
    sys.exit(1)
"

if [[ $? -ne 0 ]]; then
    echo "Configuration validation failed - exiting"
    exit 1
fi

# =============================================================================
# RUN THE TRAINING EXPERIMENT
# =============================================================================

echo "Starting Qwen-1.5B training with $DISTANCE configuration..."

timeout 12h torchrun \
    --nnodes=1 \
    --nproc_per_node=1 \
    --rdzv_id=$LSB_JOBID \
    --rdzv_backend=c10d \
    --rdzv_endpoint=$MASTER_ADDR:$MASTER_PORT \
    train_adam_distances_loss_gpt_bert_qwen.py \
    --model_type=qwen_1b \
    --distance=$DISTANCE \
    --dataset=$DATASET \
    --batch_size=$BATCH_SIZE \
    --gradient_accumulation_steps=$GRAD_ACCUM \
    --max_iters=$STEPS \
    --wandb_project="$WANDB_PROJECT" \
    --wandb_run_name=$WANDB_RUN_NAME \
    config/config.py \
    2>&1 | tee distance_results/qwen_1b_${DISTANCE}_${DATASET}_${LSB_JOBINDEX}.log

# Capture exit code
EXIT_CODE=${PIPESTATUS[0]}

# Handle timeout case
if [[ $EXIT_CODE -eq 124 ]]; then
    echo "Training timed out after 12 hours"
    EXIT_CODE=124
fi

# =============================================================================
# POST-TRAINING ANALYSIS
# =============================================================================

echo "=========== JOB COMPLETE ==========="
echo "Model Type: qwen_1b"
echo "Distance Type: $DISTANCE"
echo "Exit Code: $EXIT_CODE"
echo "Date: $(date)"
echo "Log Location: distance_results/qwen_1b_${DISTANCE}_${DATASET}_${LSB_JOBINDEX}.log"

LOG_FILE="distance_results/qwen_1b_${DISTANCE}_${DATASET}_${LSB_JOBINDEX}.log"

if [[ $EXIT_CODE -eq 0 ]]; then
    echo "Training completed successfully"

    if grep -q "GRADIENT EXPLOSION\|gradient explosion\|NaN\|nan" "$LOG_FILE"; then
        echo "GRADIENT EXPLOSION or NaN detected!"
    elif grep -q "CUDA out of memory\|OutOfMemoryError\|out of memory" "$LOG_FILE"; then
        echo "GPU OUT OF MEMORY detected!"
    elif grep -q "AssertionError\|assertion" "$LOG_FILE"; then
        echo "ASSERTION ERROR detected - check configuration!"
    elif grep -q "loss.*inf\|loss.*nan\|inf\|nan" "$LOG_FILE"; then
        echo "Infinite or NaN loss detected!"
    elif grep -q "RuntimeError\|Exception\|Error" "$LOG_FILE"; then
        echo "Runtime errors detected - check log"
    elif grep -q "Traceback" "$LOG_FILE"; then
        echo "Python traceback detected - check log"
    else
        FINAL_LOSS=$(grep -o "train loss [0-9]*\.[0-9]*" "$LOG_FILE" | tail -1 | grep -o "[0-9]*\.[0-9]*")
        if [[ -n "$FINAL_LOSS" ]]; then
            echo "Final training loss: $FINAL_LOSS"
        else
            echo "No obvious issues detected"
        fi
    fi

    if grep -q "tokens per second" "$LOG_FILE"; then
        SPEED=$(grep "tokens per second" "$LOG_FILE" | tail -1)
        echo "Training Speed: $SPEED"
    fi

else
    echo "Training failed with exit code: $EXIT_CODE"
    echo "Check log file for details: $LOG_FILE"
    echo ""
    echo "Last 10 lines of error log:"
    tail -10 "$LOG_FILE"
fi

echo "==================================="

# =============================================================================
# SUMMARY STATISTICS (if successful)
# =============================================================================

if [[ $EXIT_CODE -eq 0 ]]; then
    echo "SUMMARY FOR qwen_1b / $DISTANCE:"
    echo "   - Distance Type: $DISTANCE"
    echo "   - Job Index: $LSB_JOBINDEX"
    echo "   - WandB Run: $WANDB_RUN_NAME"
    echo "   - Log File: $LOG_FILE"
    echo ""
fi

exit $EXIT_CODE
